import time
import threading
import serial
import numpy as np
from pynput import keyboard

# =====================================================================
# [0] 아두이노 시리얼 통신 설정
# =====================================================================
PORT = 'COM3'  # 본인 PC의 아두이노 포트로 변경하세요
BAUD = 115200

try:
    py_serial = serial.Serial(PORT, BAUD, timeout=1)
    time.sleep(2)
    print(f"✅ 아두이노({PORT}) 시리얼 연결 완료!")
except Exception as e:
    print(f"❌ 아두이노 연결 실패: {e}")
    exit()

# 실시간 아두이노 센서 데이터
arduino_data = {'flex': 0, 'fsr': 0}

# =====================================================================
# [1] 시스템 전역 변수 및 제어 플래그
# =====================================================================
is_running = True
space_event = threading.Event() 

# [모터 초기 위치 설정]
# 1번 모터(쥐기): 각도가 커질수록 당김 -> 초기 풀림 상태는 0도
# 2번 모터(펴기): 각도가 작아질수록 당김 -> 초기 풀림 상태는 180도
M1_INIT_POS = 0    
M2_INIT_POS = 180  

# 모터 한계값 (모드 1에서 세팅)
m1_limit = 180  
m2_limit = 0    

# 플렉시블 센서 한계값 (모드 2에서 세팅)
flex_max_open = 0 
flex_max_close = 1023 

# 모터 속도 k (모드 3에서 세팅)
initial_k = 20  

# =====================================================================
# [2] 아두이노 데이터 수신 스레드
# =====================================================================
def read_arduino_data():
    global arduino_data, is_running
    while is_running:
        if py_serial.in_waiting > 0:
            try:
                line = py_serial.readline().decode('utf-8').strip()
                if line.startswith("DATA,"):
                    parts = line.split(',')
                    arduino_data['flex'] = int(parts[1])
                    arduino_data['fsr'] = int(parts[2])
            except Exception:
                pass
        time.sleep(0.01)

# =====================================================================
# [3] 키보드 이벤트 리스너 (스페이스바)
# =====================================================================
def on_press(key):
    global is_running
    try:
        if key == keyboard.Key.space:
            space_event.set() # 스페이스바가 눌리면 신호 발생
            
        elif hasattr(key, 'char') and key.char == 'q': # 비상 종료용 (선택)
            is_running = False
            space_event.set()
    except Exception:
        pass

# =====================================================================
# [4] 모터 명령 전송 헬퍼 함수
# =====================================================================
def send_motor(motor_num, angle, speed=100):
    """아두이노로 모터 제어 명령을 보냅니다. 예: M1,90,20"""
    cmd = f"M{motor_num},{int(angle)},{int(speed)}\n"
    py_serial.write(cmd.encode('utf-8'))

# =====================================================================
# [5] 메인 시나리오 로직 (초기화 ~ 모드 3)
# =====================================================================
def run_scenario():
    global m1_limit, m2_limit
    global flex_max_open, flex_max_close, initial_k
    
    print("\n==================================================")
    print(" 🤖 스마트 손가락 재활 로봇 초기화")
    print("==================================================")
    print("▶ 스페이스바를 누르면 시스템 작동을 시작합니다.")
    space_event.clear(); space_event.wait()
    
    # 0. 초기 위치 세팅
    print("⚙️ 초기 위치 세팅 중... (1번 풀림, 2번 풀림)")
    send_motor(1, M1_INIT_POS)
    send_motor(2, M2_INIT_POS)
    time.sleep(1)

    # ---------------------------------------------------------
    # [모드 1] 환자 맞춤 와이어 세팅 모드
    # ---------------------------------------------------------
    print("\n▶ [모드 1] 환자 맞춤 와이어 세팅 모드를 시작하려면 스페이스바를 누르세요.")
    space_event.clear(); space_event.wait()
    
    # 동작 1: 2번 모터(펴기) 한계 설정
    print("\n[안내] 환자가 손바닥을 최대한 피도록 해주세요.")
    print("▶ 준비가 되면 스페이스바를 누르세요. (모터가 당겨지기 시작합니다)")
    space_event.clear(); space_event.wait()
    
    print("⚙️ 2번 모터 당기는 중... 와이어가 짱짱해지면 스페이스바를 눌러 멈추세요!")
    curr_m2 = M2_INIT_POS # 180에서 시작
    space_event.clear()
    while is_running and not space_event.is_set() and curr_m2 >= 0:
        send_motor(2, curr_m2, 20)
        curr_m2 -= 1 # 시계 반대 방향 (각도 감소)
        time.sleep(0.05)
        
    m2_limit = curr_m2
    print(f"✅ 2번 모터 한계(최소 각도) 기억 완료: {m2_limit}도")
    send_motor(2, M2_INIT_POS) # 원래 위치로 복귀
    print("🔄 2번 모터를 초기 위치로 되돌려 놓았습니다.")
    
    # 동작 2: 1번 모터(쥐기) 한계 설정
    print("\n[안내] 환자가 주먹을 쥐도록 해주세요.")
    print("▶ 준비가 되면 스페이스바를 누르세요. (모터가 당겨지기 시작합니다)")
    space_event.clear(); space_event.wait()
    
    print("⚙️ 1번 모터 당기는 중... 와이어가 짱짱해지면 스페이스바를 눌러 멈추세요!")
    curr_m1 = M1_INIT_POS # 0에서 시작
    space_event.clear()
    while is_running and not space_event.is_set() and curr_m1 <= 180:
        send_motor(1, curr_m1, 20)
        curr_m1 += 1 # 시계 방향 (각도 증가)
        time.sleep(0.05)
        
    m1_limit = curr_m1
    print(f"✅ 1번 모터 한계(최대 각도) 기억 완료: {m1_limit}도")
    send_motor(1, M1_INIT_POS) # 원래 위치로 복귀
    print("🔄 1번 모터를 초기 위치로 되돌려 놓았습니다.")
    print("\n🎉 [모드 1] 환자 맞춤 와이어 세팅 완료!")

    # ---------------------------------------------------------
    # [모드 2] 환자 손가락 정보 수집 모드
    # ---------------------------------------------------------
    print("\n▶ [모드 2] 환자 손가락 정보 수집 모드를 시작하려면 스페이스바를 누르세요.")
    space_event.clear(); space_event.wait()
    
    # 펴짐 센서 측정
    print("\n[안내] 손가락의 최대 펴짐 각도를 측정합니다.")
    print("▶ 스페이스바를 누르면 2번 모터가 당겨집니다. 다 펴지면 스페이스바를 누르세요.")
    space_event.clear(); space_event.wait()
    
    print(f"⚙️ 2번 모터 당기는 중... (최대한계: {m2_limit}도)")
    curr_m2 = M2_INIT_POS
    space_event.clear()
    while is_running and not space_event.is_set() and curr_m2 >= m2_limit:
        send_motor(2, curr_m2, 20)
        curr_m2 -= 1
        time.sleep(0.05)
        
    flex_max_open = arduino_data['flex']
    print(f"✅ 손가락 최대 펴짐값 기억 완료: {flex_max_open}")
    send_motor(2, M2_INIT_POS)
    print("🔄 2번 모터를 초기 위치로 되돌려 놓았습니다.")
    
    # 굽혀짐 센서 측정
    print("\n[안내] 손가락의 최대 움켜쥠 각도를 측정합니다.")
    print("▶ 스페이스바를 누르면 1번 모터가 당겨집니다. 다 굽혀지면 스페이스바를 누르세요.")
    space_event.clear(); space_event.wait()
    
    print(f"⚙️ 1번 모터 당기는 중... (최대한계: {m1_limit}도)")
    curr_m1 = M1_INIT_POS
    space_event.clear()
    while is_running and not space_event.is_set() and curr_m1 <= m1_limit:
        send_motor(1, curr_m1, 20)
        curr_m1 += 1
        time.sleep(0.05)
        
    flex_max_close = arduino_data['flex']
    print(f"✅ 손가락 최대 굽혀짐값 기억 완료: {flex_max_close}")
    send_motor(1, M1_INIT_POS)
    print("🔄 1번 모터를 초기 위치로 되돌려 놓았습니다.")
    print("\n🎉 [모드 2] 환자 손가락 정보 수집 완료!")

    # ---------------------------------------------------------
    # [모드 3] 손가락 근력 측정 모드
    # ---------------------------------------------------------
    print("\n▶ [모드 3] 손가락 근력(악력) 측정 모드를 시작하려면 스페이스바를 누르세요.")
    space_event.clear(); space_event.wait()
    
    print("\n📢 [측정 시작] 지금부터 5초간 압력센서를 있는 힘껏 쥐어주세요!")
    fsr_sum = 0
    for i in range(5, 0, -1):
        print(f" ⏱️ {i}초 남았습니다... (현재 악력: {arduino_data['fsr']})")
        fsr_sum += arduino_data['fsr']
        time.sleep(1)
        
    avg_fsr = fsr_sum / 5.0
    # 악력(0~1023)에 따라 치료 초기 속도 k (15~60) 지정
    initial_k = max(15, min(60, int((avg_fsr / 1023.0) * 45) + 15)) 
    print(f"\n✅ 5초 측정 완료! 평균 악력: {avg_fsr:.1f}")
    print(f"✅ 환자 맞춤 재활치료 초기 속도 [k] 지정 완료: {initial_k}")
    
    print("\n==================================================")
    print(" ✨ 모든 초기 세팅(모드 1~3)이 완벽하게 끝났습니다!")
    print(" (RL 치료 모드 대기...)")
    print("==================================================")

# =====================================================================
# 실행부
# =====================================================================
if __name__ == "__main__":
    arduino_thread = threading.Thread(target=read_arduino_data, daemon=True)
    arduino_thread.start()
    
    listener = keyboard.Listener(on_press=on_press)
    listener.start()
    
    # 시나리오 실행
    run_scenario()
    
    is_running = False
    py_serial.close()
